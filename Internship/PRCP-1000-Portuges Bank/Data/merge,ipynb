import json

def merge_ipynb(file1, file2, output_file):
    # Load first notebook
    with open(file1, 'r', encoding='utf-8') as f1:
        nb1 = json.load(f1)

    # Load second notebook
    with open(file2, 'r', encoding='utf-8') as f2:
        nb2 = json.load(f2)

    # Merge the cells from both notebooks
    merged_notebook = nb1.copy()
    merged_notebook['cells'].extend(nb2['cells'])

    # Optional: merge metadata if needed
    merged_notebook['metadata'].update(nb2.get('metadata', {}))

    # Save merged notebook
    with open(output_file, 'w', encoding='utf-8') as f_out:
        json.dump(merged_notebook, f_out, indent=2, ensure_ascii=False)

    print(f"✅ Merged '{file1}' and '{file2}' into '{output_file}'")

# Example usage:
# merge_ipynb("notebook1.ipynb", "notebook2.ipynb", "merged.ipynb")

if __name__ == "__main__":
    # You can change these file names as needed
    merge_ipynb("./EDA.ipynb", "./MLmodels.ipynb", "merged_output.ipynb")
